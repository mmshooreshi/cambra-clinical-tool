// SCORE BADGE
// ═══════════════════════════════════════════════════════════════════════════════
function ScoreBadge({ value, sign, color, lang }) {
    const [pop, setPop] = useState(false);
    useEffect(() => { setPop(true); const t=setTimeout(()=>setPop(false),500); return ()=>clearTimeout(t); }, [value]);
    const g = { red:'from-red-500 to-rose-600', amber:'from-amber-400 to-orange-500', emerald:'from-emerald-400 to-teal-500' }[color];
    return (
        <div className={`inline-flex items-center gap-0.5 px-2.5 py-1 rounded-xl bg-gradient-to-r ${g} text-white font-black text-sm font-mono shadow-lg transition-all duration-500 ${pop?'scale-125 -rotate-3':'scale-100 rotate-0'}`} dir="ltr">
            <span className="opacity-80">{sign}</span>
            <span>{toFa(Math.abs(value),lang)}</span>
        </div>
    );
}

