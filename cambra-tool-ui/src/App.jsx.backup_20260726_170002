        const hc={red:'hover:bg-red-50/50',amber:'hover:bg-amber-50/50',emerald:'hover:bg-emerald-50/50'}[color];
        return (
            <div className={`flex flex-col py-4 px-4 sm:px-5 border-b border-slate-100 transition-all duration-200 cursor-pointer select-none active:bg-slate-100 ${checked?'bg-slate-50/80':`bg-white ${hc}`}`} onClick={()=>onChange(idx)}>
                <div className="flex items-center justify-between gap-3">
                    <div className="flex items-center gap-3 flex-1 min-w-0">
                        <div className={`flex-shrink-0 w-7 h-7 rounded-xl border-2 flex items-center justify-center transition-all duration-300 ${checked?`${ac} border-transparent shadow-lg`:'border-slate-300 bg-white'}`}>
                            <Check className={`w-4 h-4 text-white transition-all duration-300 ${checked?'opacity-100 scale-100':'opacity-0 scale-50'}`} strokeWidth={3}/>
                        </div>
                        <span className={`text-[15px] font-bold leading-snug transition-colors ${checked?'text-slate-900':'text-slate-600'}`}>{label}</span>
                    </div>
                    <div className={`transition-all duration-500 ${checked?'opacity-100 scale-100':'opacity-0 scale-0 w-0'}`}>
                        <ScoreBadge value={parseInt(weightTag.replace(/[^0-9]/g,''))} sign={weightTag[0]} color={color} lang={lang}/>
                    </div>
                </div>
                <InfoDrawer shortHint={shortHint} fullText={fullHintText} color={color}/>
            </div>
        );
    };

    return (
        <div dir={isRtl?'rtl':'ltr'} className={`min-h-screen bg-gradient-to-b from-slate-50 to-slate-100/80 text-slate-900 font-sans ${isW?'':'pb-20'} print:pb-0 ${isRtl?'font-arabic':''}`}>

            {/* HEADER */}
            <header className="bg-white/80 backdrop-blur-xl border-b border-slate-200/80 px-4 py-2.5 sticky top-0 z-30 flex items-center justify-between gap-3">
                <div className="flex items-center gap-2.5">
                    <div className="w-8 h-8 bg-gradient-to-br from-slate-800 to-slate-950 text-white rounded-xl flex items-center justify-center shadow-md">
                        <Activity className="w-4 h-4"/>
                    </div>
                    <div className="flex flex-col">
                        <h1 className="font-black text-sm sm:text-base text-slate-900 leading-tight">{t.title}</h1>
                        <span className="text-[8px] font-black text-slate-400 uppercase tracking-[0.15em]">{t.subtitle}</span>
                    </div>
                </div>
                <div className="flex items-center gap-1.5">
                    {isAdmin && <a href="/appliance_survey/admin-cambra-789" target="_blank" className="w-8 h-8 rounded-xl bg-indigo-50 hover:bg-indigo-100 flex items-center justify-center cursor-pointer active:scale-90 transition-all border border-indigo-200"><Settings className="w-3.5 h-3.5 text-indigo-600"/></a>}
                    <button onClick={()=>setLang(lang==='en'?'fa':'en')} className="h-8 px-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-bold cursor-pointer active:scale-95 transition-all border border-slate-200">{t.language}</button>
                </div>
            </header>

            {/* TAB BAR */}
            {!isW && (
                <div className="bg-white/80 backdrop-blur-xl border-b border-slate-200/80 sticky top-[45px] z-20">
                    <div className="max-w-3xl mx-auto flex">
                        {headerTabs.map(tab=>(
                            <button key={tab.id} onClick={()=>setActiveTab(tab.id)}
                                className={`flex-1 flex flex-col items-center gap-0.5 py-2 px-1 text-[10px] font-bold border-b-2 transition-all cursor-pointer ${activeTab===tab.id?'border-slate-900 text-slate-900':'border-transparent text-slate-400 hover:text-slate-600'}`}>
                                <tab.icon className={`w-3.5 h-3.5 transition-colors ${activeTab===tab.id?'text-slate-900':'text-slate-300'}`}/>
                                {tab.label}
                            </button>
                        ))}
                    </div>
                </div>
            )}

            {/* MAIN */}
            <main className="max-w-3xl mx-auto p-4 md:p-6">
                {isW && <WelcomeScreen lang={lang} onStart={()=>setActiveTab('patient')}/>}

                <div className={isW?'hidden':'space-y-6'}>

                    {/* PATIENT */}
                    <div className={activeTab!=='patient'?'hidden':''}>
                        <div className="cambra-fade-in bg-white rounded-3xl border-2 border-slate-200 overflow-visible shadow-sm">
                            <div className="bg-gradient-to-r from-slate-50 to-slate-100 px-5 py-3 border-b border-slate-200 rounded-t-3xl">
                                <h2 className="text-sm font-black text-slate-700 uppercase tracking-widest">{t.patientInfo}</h2>
                            </div>
                            <div className="p-5 grid grid-cols-1 sm:grid-cols-2 gap-5">
                                <div className="flex flex-col gap-1.5">
                                    <label className="text-xs font-bold text-slate-500 uppercase tracking-wider">{t.patientName}</label>
                                    <div className="relative">
                                        <div className="absolute top-1/2 -translate-y-1/2 start-3 w-8 h-8 rounded-xl bg-slate-100 flex items-center justify-center"><User className="w-3.5 h-3.5 text-slate-500"/></div>
                                        <input type="text" value={patient.name} onChange={e=>setPatient(p=>({...p,name:e.target.value}))}
                                            className="w-full text-base font-bold ps-13 pe-4 py-3 border-2 border-slate-200 rounded-2xl outline-none focus:border-indigo-400 focus:shadow-lg focus:shadow-indigo-100/50 transition-all"
                                            placeholder={isRtl?'نام بیمار...':'Patient name...'}/>
                                    </div>
                                </div>
                                <div className="flex flex-col gap-1.5">
                                    <label className="text-xs font-bold text-slate-500 uppercase tracking-wider">{t.chartNo}</label>
                                    <div className="relative">
                                        <div className="absolute top-1/2 -translate-y-1/2 start-3 w-8 h-8 rounded-xl bg-slate-100 flex items-center justify-center"><ClipboardCheck className="w-3.5 h-3.5 text-slate-500"/></div>
                                        <input type="text" value={toFaS(patient.chartNo,lang)}
                                            onChange={e=>{let v=e.target.value;if(isRtl)v=v.replace(/[۰-۹]/g,d=>String.fromCharCode(d.charCodeAt(0)-1728+48));setPatient(p=>({...p,chartNo:v}))}}
                                            className="w-full text-base font-bold ps-13 pe-13 py-3 border-2 border-slate-200 rounded-2xl outline-none focus:border-indigo-400 focus:shadow-lg focus:shadow-indigo-100/50 transition-all font-mono"
                                            placeholder={isRtl?'شماره پرونده...':'Chart #...'}/>
                                        <button onClick={genChart} type="button" className="absolute top-1/2 -translate-y-1/2 end-2 w-8 h-8 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center cursor-pointer active:scale-90 transition-all shadow-md">
                                            <Shuffle className="w-3.5 h-3.5 text-white"/>
                                        </button>
                                    </div>
                                </div>
                                <div className="flex flex-col gap-1.5">
                                    <label className="text-xs font-bold text-slate-500 uppercase tracking-wider">{t.date}</label>
                                    <CalendarPicker value={patient.date} onChange={v=>setPatient(p=>({...p,date:v}))} lang={lang}/>
                                </div>
                                <div className="flex flex-col gap-1.5">
                                    <label className="text-xs font-bold text-slate-500 uppercase tracking-wider">{t.assessmentType}</label>
                                    <CustomSelect value={patient.assessmentType} onChange={v=>setPatient(p=>({...p,assessmentType:v}))}
                                        options={[{value:'baseline',label:t.baseline,desc:isRtl?'اولین ارزیابی':'First assessment'},{value:'recall',label:t.recall,desc:isRtl?'پیگیری دوره‌ای':'Follow-up'}]}
                                        placeholder={isRtl?'انتخاب...':'Select...'} lang={lang} icon={ClipboardCheck}/>
                                </div>
                            </div>
                        </div>
                    </div>

                    {/* DISEASE/RISK */}
                    <div className={`${activeTab!=='disease'?'hidden':''} space-y-6`}>
                        <div className="cambra-fade-in bg-white rounded-3xl border-2 border-slate-200 overflow-hidden shadow-sm">
                            <div className="bg-gradient-to-r from-red-50 to-rose-50 border-b border-red-100 px-5 py-3">
                                <h2 className="text-sm font-black text-red-800 uppercase tracking-widest">{t.diseaseIndicators}</h2>
                                <p className="text-[11px] text-red-500 mt-0.5 font-bold">{t.diseaseIndSubtitle}</p>
                            </div>
                            {Array.from({length:settings.diseaseCount}).map((_,i)=><DataRow key={`di_${i}`} label={t[`di_${i+1}`]} shortHint={t[`di_${i+1}_hint`]} fullHintText={FH[lang][`di_${i+1}`]} checked={diseaseInd[i]} onChange={x=>toggle(setDiseaseInd,x)} idx={i} color="red" weightTag={`+${settings.diseaseWeight}`}/>)}
                        </div>
                        <div className="cambra-fade-in cambra-stagger-2 bg-white rounded-3xl border-2 border-slate-200 overflow-hidden shadow-sm">
                            <div className="bg-gradient-to-r from-amber-50 to-orange-50 border-b border-amber-100 px-5 py-3">
                                <h2 className="text-sm font-black text-amber-800 uppercase tracking-widest">{t.riskFactors}</h2>
                                <p className="text-[11px] text-amber-600 mt-0.5 font-bold">{t.riskFactSubtitle}</p>
                            </div>
                            {Array.from({length:settings.riskCount}).map((_,i)=><DataRow key={`rf_${i}`} label={t[`rf_${i+1}`]} shortHint={t[`rf_${i+1}_hint`]} fullHintText={FH[lang][`rf_${i+1}`]} checked={riskFact[i]} onChange={x=>toggle(setRiskFact,x)} idx={i} color="amber" weightTag={`+${settings.riskWeight}`}/>)}
                        </div>
                    </div>

                    {/* PROTECTIVE */}
                    <div className={`${activeTab!=='protective'?'hidden':''}`}>
                        <div className="cambra-fade-in bg-white rounded-3xl border-2 border-slate-200 overflow-hidden shadow-sm">
                            <div className="bg-gradient-to-r from-emerald-50 to-teal-50 border-b border-emerald-100 px-5 py-3">
                                <h2 className="text-sm font-black text-emerald-800 uppercase tracking-widest">{t.protectiveFactors}</h2>
                                <p className="text-[11px] text-emerald-600 mt-0.5 font-bold">{t.protFactSubtitle}</p>
                            </div>
                            {Array.from({length:settings.protectiveCount}).map((_,i)=><DataRow key={`pf_${i}`} label={t[`pf_${i+1}`]} shortHint={t[`pf_${i+1}_hint`]} fullHintText={FH[lang][`pf_${i+1}`]} checked={protFact[i]} onChange={x=>toggle(setProtFact,x)} idx={i} color="emerald" weightTag={`-${settings.protectiveWeight}`}/>)}
                        </div>
                    </div>

                    {/* RESULTS */}
                    <div className={`${activeTab!=='results'?'hidden':'block'} space-y-6 pb-16`}>
                        {/* Status */}
                        <div className="cambra-fade-in relative w-full mb-8">
                            <div className="relative w-full rounded-3xl border-4 border-slate-900 shadow-[10px_10px_0px_#0f172a] hover:shadow-[3px_3px_0px_#0f172a] hover:translate-x-1.5 hover:translate-y-1.5 transition-all duration-300 flex flex-col md:flex-row overflow-hidden bg-white cursor-default">
                                <div className={`relative flex-1 p-6 sm:p-10 flex flex-col justify-center overflow-hidden ${CatColors[results.finalCat]}`}>
                                    <div className="absolute inset-0 opacity-10 pointer-events-none" style={{backgroundImage:'radial-gradient(rgba(255,255,255,0.3) 1px, transparent 1px)',backgroundSize:'20px 20px'}}/>
                                    <Shield className="absolute -right-12 -bottom-12 w-60 h-60 opacity-[0.06] text-white rotate-12 pointer-events-none" strokeWidth={1}/>
                                    <div className="relative z-10">
                                        <div className="inline-flex items-center gap-2 px-3 py-1 bg-white/15 border border-white/25 rounded-full text-[9px] font-black uppercase tracking-[0.2em] text-white/90 mb-4 backdrop-blur-sm">
                                            <Activity className="w-3 h-3"/>{isRtl?'نتیجه آنالیز':'VERDICT'}
                                        </div>
                                        <h2 className="text-4xl sm:text-5xl font-black uppercase tracking-tighter leading-[0.85] text-white drop-shadow-[3px_3px_0px_rgba(0,0,0,0.3)]">{t[results.finalCat]}</h2>
                                    </div>
                                </div>
                                <div className="w-full md:w-[260px] bg-slate-900 text-white p-5 sm:p-7 flex flex-col justify-between border-t-4 md:border-t-0 md:border-l-4 border-slate-800 relative">
                                    <div className="relative z-10 mb-4">
                                        <span className="text-[9px] font-black uppercase tracking-[0.2em] text-slate-500 flex items-center gap-1.5">
                                            <div className="w-1.5 h-1.5 bg-indigo-400 rounded-full animate-pulse"/>{isRtl?'نمره خالص':'NET SCORE'}
                                        </span>
                                        <div className="flex items-end gap-2 mt-2" dir="ltr">
                                            <span className="text-5xl font-black font-mono leading-none tracking-tighter">{results.score>0?'+':''}{toFa(results.score,lang)}</span>
                                            <span className="text-xs font-bold text-slate-500 mb-1.5">pts</span>
                                        </div>
                                        {patient.date && (
                                            <div className="mt-2 flex items-center gap-1.5 text-slate-500 text-[10px] font-bold" dir={isRtl?'rtl':'ltr'}>
                                                <Calendar className="w-3 h-3"/>
                                                {(()=>{const[y,m,d]=patient.date.split('-').map(Number);return isRtl?`${toFa(d,'fa')} ${JM[m-1]} ${toFa(y,'fa')}`:`${GM[m-1]} ${d}, ${y}`;})()}
                                            </div>
                                        )}
                                    </div>
                                    <div className="relative z-10">
                                        {results.hasHyposalivation?(
                                            <div className="bg-gradient-to-r from-red-500 to-rose-600 text-white border border-red-300/50 p-3 rounded-2xl shadow-lg shadow-red-500/30">
                                                <span className="flex items-center gap-1.5 text-[8px] font-black uppercase tracking-widest mb-0.5 opacity-80"><Droplets className="w-3 h-3"/>{isRtl?'بحرانی':'CRITICAL'}</span>
                                                <span className="font-bold text-xs block">{isRtl?'نقص بزاق':'HYPOSALIVATION'}</span>
                                            </div>
                                        ):(
                                            <div className="bg-slate-800/80 text-slate-500 border border-slate-700 p-3 rounded-2xl border-dashed">
                                                <span className="flex items-center gap-1.5 text-[8px] font-black uppercase tracking-widest mb-0.5 opacity-50"><Droplets className="w-3 h-3"/>{isRtl?'وضعیت':'STATUS'}</span>
                                                <span className="font-bold text-xs block opacity-50">{isRtl?'بزاق نرمال':'NORMAL'}</span>
                                            </div>
                                        )}
                                    </div>
                                </div>
                            </div>
                        </div>

                        {/* Score cards */}
                        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                            {[
                                {k:'di',sc:results.dScore,s:'+',m:'bg-gradient-to-br from-red-500 to-rose-600',l:'bg-red-50',b:'border-red-200',tx:'text-red-800',lb:isRtl?'پاتولوژی':'PATHOLOGY',ic:Stethoscope,it:diseaseInd.map((c,i)=>c?t[`di_${i+1}`]:null).filter(Boolean)},
                                {k:'rf',sc:results.rScore,s:'+',m:'bg-gradient-to-br from-amber-400 to-orange-500',l:'bg-amber-50',b:'border-amber-200',tx:'text-amber-800',lb:isRtl?'بیولوژی':'BIOLOGY',ic:Zap,it:riskFact.map((c,i)=>c?t[`rf_${i+1}`]:null).filter(Boolean)},
                                {k:'pf',sc:results.pScore,s:'-',m:'bg-gradient-to-br from-emerald-400 to-teal-500',l:'bg-emerald-50',b:'border-emerald-200',tx:'text-emerald-800',lb:isRtl?'محافظت':'PROTECTION',ic:ShieldCheck,it:protFact.map((c,i)=>c?t[`pf_${i+1}`]:null).filter(Boolean)},
                            ].map((st,i)=>(
                                <div key={st.k} className={`cambra-fade-in cambra-stagger-${i+1} flex flex-col bg-white rounded-3xl border-2 border-slate-200 shadow-sm hover:shadow-xl hover:border-slate-300 transition-all duration-300 overflow-hidden cursor-default`}>
                                    <div className="p-4 flex justify-between items-start">
                                        <div className="flex flex-col gap-2">
                                            <div className={`w-10 h-10 rounded-2xl flex items-center justify-center text-white ${st.m} shadow-lg`}><st.ic className="w-5 h-5"/></div>
                                            <h3 className="font-black text-[11px] text-slate-700 uppercase tracking-widest">{st.lb}</h3>
                                        </div>
                                        <div dir="ltr" className={`px-2.5 py-1.5 rounded-xl border-2 ${st.b} ${st.l}`}>
                                            <span className={`font-mono font-black text-xl leading-none ${st.tx}`}>{st.s}{toFa(st.sc,lang)}</span>
                                        </div>
                                    </div>
                                    <div className="px-4 pb-4 flex-1">
                                        {st.it.length>0?(
                                            <div className="flex flex-wrap gap-1.5">{st.it.map((item,idx)=>(
                                                <div key={idx} className={`inline-flex items-start gap-1.5 px-2 py-1 rounded-xl border ${st.b} ${st.l}`}>
                                                    <div className={`w-1.5 h-1.5 rounded-full mt-1.5 flex-shrink-0 ${st.m}`}/>
                                                    <span className={`text-[10px] font-bold leading-snug ${st.tx}`}>{item}</span>
                                                </div>
                                            ))}</div>
                                        ):(
                                            <div className="flex flex-col items-center justify-center gap-1 opacity-25 py-4">
                                                <span className="font-mono font-black text-xl">—</span>
                                                <span className="text-[9px] font-black uppercase tracking-widest">{isRtl?'خالی':'NONE'}</span>
                                            </div>
                                        )}
                                    </div>
                                </div>
                            ))}
                        </div>

                        {/* ICDAS + C */}
                        <div className="cambra-fade-in cambra-stagger-4 grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div className="bg-white rounded-2xl border-2 border-slate-200 overflow-hidden">
                                <div className="bg-gradient-to-r from-slate-800 to-slate-900 text-white px-4 py-2 flex items-center gap-2">
                                    <span className="font-black text-xs uppercase tracking-widest">ICDAS</span>
                                </div>
                                <div className="divide-y divide-slate-50">
                                    {[['0',isRtl?'سالم':'Sound'],['1',isRtl?'تغییر مینا':'Enamel change'],['2',isRtl?'ضایعه مینا':'Enamel lesion'],['3',isRtl?'شکستگی':'Microcavity'],['4',isRtl?'سایه عاج':'Shadow'],['5',isRtl?'حفره':'Cavity'],['6',isRtl?'وسیع':'Extensive']].map(([c,d])=>(
                                        <div key={c} className="flex items-center gap-3 px-4 py-1.5">
                                            <span className="w-6 h-6 rounded-lg bg-slate-900 text-white flex items-center justify-center font-black text-[11px]">{toFa(c,lang)}</span>
                                            <span className="text-xs font-bold text-slate-600">{d}</span>
                                        </div>
                                    ))}
                                </div>
                            </div>
                            <div className="bg-white rounded-2xl border-2 border-slate-200 overflow-hidden">
                                <div className="bg-gradient-to-r from-indigo-600 to-purple-700 text-white px-4 py-2 flex items-center gap-2">
                                    <span className="font-black text-xs uppercase tracking-widest">{isRtl?'پروگزیمال':'Proximal'}</span>
                                </div>
                                <div className="divide-y divide-slate-50">
                                    {[['C1',isRtl?'نیمه خارجی مینا':'Outer enamel'],['C2',isRtl?'نیمه داخلی مینا':'Inner enamel'],['C3',isRtl?'خارجی عاج':'Outer dentin'],['C4',isRtl?'میانی/داخلی عاج':'Mid/inner dentin']].map(([c,d])=>(
                                        <div key={c} className="flex items-center gap-3 px-4 py-2.5">
                                            <span className="w-9 h-7 rounded-lg bg-gradient-to-r from-indigo-500 to-purple-600 text-white flex items-center justify-center font-black text-xs shadow-sm">{c}</span>
                                            <span className="text-sm font-bold text-slate-700">{d}</span>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>

                        {/* Overrides */}
                        {(results.dOverride||results.eOverride)&&(
                            <div className="cambra-fade-in flex flex-wrap gap-3">
                                {results.dOverride&&<div className="bg-red-50 border-l-4 border-red-500 p-3 rounded-r-2xl flex-1 min-w-[200px]"><span className="flex items-center gap-1.5 text-red-600 font-black text-[11px] uppercase mb-0.5"><ArrowUpRight className="w-3.5 h-3.5"/>{t.diseaseOverride}</span><p className="text-xs font-bold text-red-800/70">{isRtl?'ضایعات فعال → پرخطر':'Active lesions → HIGH RISK'}</p></div>}
                                {results.eOverride&&<div className="bg-slate-900 text-white p-3 rounded-2xl flex-1 min-w-[200px]"><span className="flex items-center gap-1.5 text-emerald-400 font-black text-[11px] uppercase mb-0.5"><Zap className="w-3.5 h-3.5"/>{t.extremeOverride}</span><p className="text-xs font-bold text-slate-300">{isRtl?'پرخطر + نقص بزاق → بسیار پرخطر':'High + Dry Mouth → EXTREME'}</p></div>}
                            </div>
                        )}

                        {/* Action Plan */}
                        <div className="cambra-fade-in cambra-stagger-5 space-y-3">
                            <div className="flex items-center gap-2 px-1"><ClipboardCheck className="w-4 h-4 text-indigo-600"/><h3 className="font-black text-slate-900 uppercase tracking-widest text-xs">{isRtl?'برنامه درمانی':'ACTION PLAN'}</h3><div className="flex-1 h-px bg-slate-200"/></div>
                            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div className="bg-white rounded-3xl border-2 border-slate-200 overflow-hidden hover:shadow-lg transition-all">
                                    <div className="bg-slate-50 border-b-2 border-slate-200 p-3.5 flex items-center gap-2"><Calendar className="w-3.5 h-3.5 text-slate-500"/><span className="font-black text-[11px] text-slate-500 uppercase tracking-wider">{t.recDiagnostics}</span></div>
                                    <div className="p-4"><div dangerouslySetInnerHTML={{__html:t[RecMap[results.finalCat].d]}} className="text-sm text-slate-700 leading-relaxed space-y-3"/></div>
                                </div>
                                <div className="bg-white rounded-3xl border-2 border-slate-900 overflow-hidden hover:shadow-lg transition-all">
                                    <div className="bg-slate-900 p-3.5 flex items-center justify-between"><span className="font-black text-[11px] text-indigo-300 uppercase tracking-wider flex items-center gap-2"><Zap className="w-3.5 h-3.5"/>{t.recInterventions}</span><div className="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"/></div>
                                    <div className="p-4"><div dangerouslySetInnerHTML={{__html:t[RecMap[results.finalCat].i]}} className="text-sm text-slate-700 leading-relaxed space-y-3"/></div>
                                </div>
                            </div>
                        </div>

                        {/* Actions */}
                        <div className="pt-6 flex flex-col sm:flex-row items-center justify-center gap-3">
                            <button onClick={()=>setShowPdf(true)} className="group relative cursor-pointer active:scale-95 transition-transform w-full sm:w-auto">
                                <div className="absolute inset-0 bg-slate-700 rounded-2xl translate-y-1"/>
                                <div className="relative bg-slate-800 text-white px-6 py-3 rounded-2xl font-black text-sm flex items-center justify-center gap-2.5 group-hover:translate-y-0.5 transition-transform"><Download className="w-4 h-4"/>{isRtl?'ذخیره PDF':'Save PDF'}</div>
                            </button>
                            <button onClick={submit} disabled={isSubmitting} className="group relative cursor-pointer active:scale-95 transition-transform disabled:opacity-50 w-full sm:w-auto">
                                <div className="absolute inset-0 bg-indigo-800 rounded-2xl translate-y-1"/>
                                <div className="relative bg-gradient-to-r from-indigo-600 to-purple-600 text-white px-6 py-3 rounded-2xl font-black text-sm flex items-center justify-center gap-2.5 group-hover:translate-y-0.5 transition-transform shadow-lg shadow-indigo-300/20">
                                    {isSubmitting?<Activity className="animate-spin w-4 h-4"/>:<ClipboardCheck className="w-4 h-4"/>}
                                    {isSubmitting?(isRtl?'ثبت...':'SAVING...'):(isRtl?'ثبت و خروج':'FINISH & LOG')}
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </main>

            {/* NAV */}
            {!isW&&(
                <nav className="fixed bottom-2.5 left-1/2 -translate-x-1/2 w-[calc(100%-1.5rem)] max-w-xl z-40 pointer-events-none">
                    <div className="bg-white/90 backdrop-blur-xl border-2 border-slate-900 rounded-2xl px-1.5 py-1 flex items-center justify-between gap-1 pointer-events-auto shadow-[3px_3px_0px_#0f172a]">
                        <button disabled={tabOrder.indexOf(activeTab)<=1} onClick={()=>setActiveTab(tabOrder[tabOrder.indexOf(activeTab)-1])}
                            className={`flex-shrink-0 w-8 h-8 rounded-xl bg-slate-100 flex items-center justify-center disabled:opacity-20 cursor-pointer active:scale-90 transition-all ${tabOrder.indexOf(activeTab)<=1?'invisible':''}`}>
                            <ChevronLeft className={`w-4 h-4 text-slate-800 ${isRtl?'scale-x-[-1]':''}`} strokeWidth={3}/>
                        </button>
                        <div className="hidden sm:flex flex-1 justify-center gap-1.5">
                            {tabOrder.filter(t=>t!=='welcome').map((tab,idx)=>{const ci=tabOrder.indexOf(activeTab)-1;return(
                                <div key={tab} className={`transition-all duration-500 rounded-full border-2 border-slate-900 ${idx===ci?'w-5 h-2 bg-indigo-500':idx<ci?'w-2 h-2 bg-slate-900':'w-2 h-2 bg-slate-200'}`}/>
                            );})}
                        </div>
                        <div className="flex sm:hidden flex-1 justify-center">
                            <span className="font-black font-mono text-slate-800 bg-slate-100 px-2 py-0.5 rounded-lg text-[11px]" dir="ltr">{toFa(tabOrder.indexOf(activeTab),lang)}/{toFa(tabOrder.length-1,lang)}</span>
                        </div>
                        <button disabled={tabOrder.indexOf(activeTab)===tabOrder.length-1||!isValid(activeTab)} onClick={()=>setActiveTab(tabOrder[tabOrder.indexOf(activeTab)+1])}
                            className={`flex-shrink-0 w-8 h-8 rounded-xl bg-slate-100 flex items-center justify-center disabled:opacity-20 cursor-pointer active:scale-90 transition-all ${tabOrder.indexOf(activeTab)===tabOrder.length-1?'invisible':''}`}>
                            <ChevronRight className={`w-4 h-4 text-slate-800 ${isRtl?'scale-x-[-1]':''}`} strokeWidth={3}/>
                        </button>
                    </div>
                </nav>
            )}

            <PdfModal open={showPdf} onClose={()=>setShowPdf(false)} lang={lang} patient={patient} results={results} config={config} diseaseInd={diseaseInd} riskFact={riskFact} protFact={protFact}/>

            {appAlert.show&&(
                <div className="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm">
                    <div className="cambra-scale-in bg-white border-4 border-slate-900 shadow-[8px_8px_0px_rgba(0,0,0,1)] w-full max-w-sm p-6 text-center rounded-3xl">
                        <div className="mb-4">
                            {appAlert.type==='success'?<div className="w-14 h-14 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto border-4 border-emerald-500"><Check className="w-7 h-7" strokeWidth={4}/></div>
                            :<div className="w-14 h-14 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto border-4 border-red-500"><AlertCircle className="w-7 h-7" strokeWidth={4}/></div>}
                        </div>
                        <h3 className="text-lg font-black uppercase tracking-widest mb-3">{appAlert.type==='success'?(isRtl?'موفقیت':'SUCCESS'):(isRtl?'خطا':'ERROR')}</h3>
                        <p className="text-slate-600 font-bold mb-5">{appAlert.message}</p>
                        <button onClick={()=>{if(appAlert.onClose)appAlert.onClose();setAppAlert(a=>({...a,show:false,onClose:null}))}}
                            className="w-full py-3 bg-slate-900 text-white font-black uppercase tracking-widest rounded-2xl hover:bg-slate-700 cursor-pointer active:scale-95 transition-all">
                            {isRtl?'باشه':'OK'}
                        </button>
                    </div>
                </div>
            )}
        </div>
    );
}