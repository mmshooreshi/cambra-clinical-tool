    const toggle = id => setSecs(p=>p.map(s=>s.id===id?{...s,checked:!s.checked}:s));

    const gen = () => {
        const ak = secs.filter(s=>s.checked).map(s=>s.id);
        const riskLabels = {lowRisk:t?.lowRisk,moderateRisk:t?.moderateRisk,highRisk:t?.highRisk,extremeRisk:t?.extremeRisk};
        const riskColors = {lowRisk:'#059669',moderateRisk:'#d97706',highRisk:'#dc2626',extremeRisk:'#7f1d1d'};
