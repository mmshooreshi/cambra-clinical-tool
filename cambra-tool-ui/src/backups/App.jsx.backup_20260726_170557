                                    <label className="text-xs font-bold text-slate-500 uppercase tracking-wider">{t.patientName}</label>
                                    <div className="relative">
                                        <div className="absolute top-1/2 -translate-y-1/2 start-3 w-8 h-8 rounded-xl bg-slate-100 flex items-center justify-center"><User className="w-3.5 h-3.5 text-slate-500"/></div>
                                        <input type="text" value={patient.name} onChange={e=>setPatient(p=>({...p,name:e.target.value}))}
                                            className="w-full text-base font-bold ps-13 pe-4 py-3 border-2 border-slate-200 rounded-2xl outline-none focus:border-indigo-400 focus:shadow-lg focus:shadow-indigo-100/50 transition-all"
                                            placeholder={isRtl?'نام بیمار...':'Patient name...'}/>
                                    </div>
                                </div>
                                {/* Chart — numbers stay as-is, display converted */}
                                <div className="flex flex-col gap-1.5">
                                    <label className="text-xs font-bold text-slate-500 uppercase tracking-wider">{t.chartNo}</label>
                                    <div className="relative">
                                        <div className="absolute top-1/2 -translate-y-1/2 start-3 w-8 h-8 rounded-xl bg-slate-100 flex items-center justify-center"><ClipboardCheck className="w-3.5 h-3.5 text-slate-500"/></div>
                                        <input type="text" value={patient.chartNo}
                                            onChange={e=>setPatient(p=>({...p,chartNo:e.target.value}))}
                                            className="w-full text-base font-bold ps-13 pe-12 py-3 border-2 border-slate-200 rounded-2xl outline-none focus:border-indigo-400 focus:shadow-lg focus:shadow-indigo-100/50 transition-all font-mono"
                                            placeholder={isRtl?'شماره پرونده...':'Chart #...'}
                                            dir="ltr"/>
                                        <button onClick={genChart} type="button" className="absolute top-1/2 -translate-y-1/2 end-2 w-8 h-8 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center cursor-pointer active:scale-90 transition-all shadow-md">
                                            <Shuffle className="w-3.5 h-3.5 text-white"/>
                                        </button>
                                    </div>
                                </div>
                                {/* Date */}
                                <div className="flex flex-col gap-1.5">
                                    <label className="text-xs font-bold text-slate-500 uppercase tracking-wider">{t.date}</label>
                                    <CalendarPicker value={patient.date} onChange={v=>setPatient(p=>({...p,date:v}))} lang={lang}/>
                                </div>
                                {/* Type */}
                                <div className="flex flex-col gap-1.5">
                                    <label className="text-xs font-bold text-slate-500 uppercase tracking-wider">{t.assessmentType}</label>
                                    <CustomSelect value={patient.assessmentType} onChange={v=>setPatient(p=>({...p,assessmentType:v}))}
                                        options={[{value:'baseline',label:t.baseline,desc:isRtl?'اولین ارزیابی':'First assessment'},{value:'recall',label:t.recall,desc:isRtl?'پیگیری':'Follow-up'}]}
                                        placeholder={isRtl?'انتخاب...':'Select...'} lang={lang} icon={ClipboardCheck}/>
                                </div>
                            </div>
                        </div>
                    </div>

                    {/* DISEASE/RISK */}
                    <div className={`${activeTab!=='disease'?'hidden':''} space-y-6`}>
                        <div className="c-fade bg-white rounded-3xl border-2 border-slate-200 overflow-hidden shadow-sm">
                            <div className="bg-gradient-to-r from-red-50 to-rose-50 border-b border-red-100 px-5 py-3">
                                <h2 className="text-xs font-black text-red-800 uppercase tracking-widest">{t.diseaseIndicators}</h2>
                                <p className="text-[10px] text-red-500 mt-0.5 font-bold">{t.diseaseIndSubtitle}</p>
                            </div>
                            {Array.from({length:stg.diseaseCount}).map((_,i)=>
                                <DataRow key={`di${i}`} prefix="di" idx={i} checked={diseaseInd[i]} onToggle={x=>toggle(setDiseaseInd,x)} color="red" weight={stg.diseaseWeight}/>
                            )}
                        </div>
                        <div className="c-fade c-d1 bg-white rounded-3xl border-2 border-slate-200 overflow-hidden shadow-sm">
                            <div className="bg-gradient-to-r from-amber-50 to-orange-50 border-b border-amber-100 px-5 py-3">
                                <h2 className="text-xs font-black text-amber-800 uppercase tracking-widest">{t.riskFactors}</h2>
                                <p className="text-[10px] text-amber-600 mt-0.5 font-bold">{t.riskFactSubtitle}</p>
                            </div>
                            {Array.from({length:stg.riskCount}).map((_,i)=>
                                <DataRow key={`rf${i}`} prefix="rf" idx={i} checked={riskFact[i]} onToggle={x=>toggle(setRiskFact,x)} color="amber" weight={stg.riskWeight}/>
                            )}
                        </div>
                    </div>

                    {/* PROTECTIVE */}
                    <div className={activeTab!=='protective'?'hidden':''}>
                        <div className="c-fade bg-white rounded-3xl border-2 border-slate-200 overflow-hidden shadow-sm">
                            <div className="bg-gradient-to-r from-emerald-50 to-teal-50 border-b border-emerald-100 px-5 py-3">
                                <h2 className="text-xs font-black text-emerald-800 uppercase tracking-widest">{t.protectiveFactors}</h2>
                                <p className="text-[10px] text-emerald-600 mt-0.5 font-bold">{t.protFactSubtitle}</p>
                            </div>
                            {Array.from({length:stg.protectiveCount}).map((_,i)=>
                                <DataRow key={`pf${i}`} prefix="pf" idx={i} checked={protFact[i]} onToggle={x=>toggle(setProtFact,x)} color="emerald" weight={stg.protectiveWeight}/>
                            )}
                        </div>
                    </div>

                    {/* RESULTS */}
                    <div className={`${activeTab!=='results'?'hidden':'block'} space-y-5 pb-12`}>
                        {/* Main result card */}
                        <div className="c-fade relative w-full">
                            <div className="relative w-full rounded-3xl border-4 border-slate-900 shadow-[8px_8px_0px_#0f172a] hover:shadow-[3px_3px_0px_#0f172a] hover:translate-x-1 hover:translate-y-1 transition-all duration-300 flex flex-col md:flex-row overflow-hidden bg-white cursor-default">
                                <div className={`relative flex-1 p-6 sm:p-8 flex flex-col justify-center overflow-hidden ${CatBg[results.finalCat]}`}>
                                    <div className="absolute inset-0 opacity-[.08] pointer-events-none" style={{backgroundImage:'radial-gradient(rgba(255,255,255,.4) 1px, transparent 1px)',backgroundSize:'16px 16px'}}/>
                                    <Shield className="absolute -right-10 -bottom-10 w-52 h-52 opacity-[.05] text-white rotate-12 pointer-events-none" strokeWidth={1}/>
                                    <div className="relative z-10">
                                        <div className="inline-flex items-center gap-1.5 px-2.5 py-1 bg-white/15 border border-white/20 rounded-full text-[9px] font-black uppercase tracking-[.15em] text-white/80 mb-4 backdrop-blur-sm">
                                            <Activity className="w-2.5 h-2.5"/>{isRtl?'نتیجه آنالیز':'VERDICT'}
                                        </div>
                                        <h2 className="text-4xl sm:text-5xl font-black uppercase tracking-tighter leading-[.85] text-white drop-shadow-[3px_3px_0_rgba(0,0,0,.25)]">{t[results.finalCat]}</h2>
                                    </div>
                                </div>
                                <div className="w-full md:w-[220px] bg-slate-900 text-white p-5 flex flex-col justify-between border-t-4 md:border-t-0 md:border-l-4 border-slate-800 relative">
                                    <div className="relative z-10 mb-4">
                                        <span className="text-[9px] font-black uppercase tracking-[.2em] text-slate-500 flex items-center gap-1.5">
                                            <div className="w-1.5 h-1.5 bg-indigo-400 rounded-full animate-pulse"/>{isRtl?'نمره':'SCORE'}
                                        </span>
                                        <div className="flex items-end gap-1.5 mt-2" dir="ltr">
                                            <span className="text-5xl font-black font-mono leading-none tracking-tighter">{results.score>0?'+':''}{toFa(results.score,lang)}</span>
                                        </div>
                                        {patient.date&&<div className="mt-2 flex items-center gap-1 text-slate-500 text-[10px] font-bold" dir={isRtl?'rtl':'ltr'}><Calendar className="w-2.5 h-2.5"/>{dateDisp}</div>}
                                    </div>
                                    <div className="relative z-10">
                                        {results.hasHyposalivation?(
                                            <div className="bg-red-500/90 text-white border border-red-300/40 p-2.5 rounded-xl">
                                                <span className="flex items-center gap-1 text-[8px] font-black uppercase tracking-widest mb-0.5 opacity-80"><Droplets className="w-2.5 h-2.5"/>{isRtl?'بحرانی':'CRITICAL'}</span>
                                                <span className="font-bold text-xs block">{isRtl?'نقص بزاق':'HYPOSALIVATION'}</span>
                                            </div>
                                        ):(
                                            <div className="bg-slate-800/60 text-slate-500 border border-slate-700/50 p-2.5 rounded-xl border-dashed">
                                                <span className="flex items-center gap-1 text-[8px] font-black uppercase tracking-widest mb-0.5 opacity-50"><Droplets className="w-2.5 h-2.5"/>{isRtl?'وضعیت':'STATUS'}</span>
                                                <span className="font-bold text-xs block opacity-50">{isRtl?'نرمال':'NORMAL'}</span>
                                            </div>
                                        )}
                                    </div>
                                </div>
                            </div>
                        </div>

                        {/* Score summary — compact inline */}
                        <div className="c-fade c-d1 flex flex-wrap gap-3">
                            {[
                                {k:'di',sc:results.dScore,s:'+',bg:'from-red-500 to-rose-600',lb:isRtl?'پاتولوژی':'Pathology',ic:Stethoscope,items:diseaseInd.map((c,i)=>c?t[`di_${i+1}`]:null).filter(Boolean)},
                                {k:'rf',sc:results.rScore,s:'+',bg:'from-amber-400 to-orange-500',lb:isRtl?'ریسک':'Risk',ic:Zap,items:riskFact.map((c,i)=>c?t[`rf_${i+1}`]:null).filter(Boolean)},
                                {k:'pf',sc:results.pScore,s:'-',bg:'from-emerald-400 to-teal-500',lb:isRtl?'محافظت':'Protection',ic:ShieldCheck,items:protFact.map((c,i)=>c?t[`pf_${i+1}`]:null).filter(Boolean)},
                            ].map(st=>(
                                <div key={st.k} className="flex-1 min-w-[140px] bg-white rounded-2xl border-2 border-slate-200 p-3 hover:shadow-md transition-all cursor-default">
                                    <div className="flex items-center justify-between mb-2">
                                        <div className="flex items-center gap-2">
                                            <div className={`w-7 h-7 rounded-xl bg-gradient-to-br ${st.bg} flex items-center justify-center text-white shadow-sm`}><st.ic className="w-3.5 h-3.5"/></div>
                                            <span className="text-[10px] font-black text-slate-500 uppercase tracking-wider">{st.lb}</span>
                                        </div>
                                        <span className={`font-mono font-black text-lg bg-gradient-to-r ${st.bg} bg-clip-text text-transparent`} dir="ltr">{st.s}{toFa(st.sc,lang)}</span>
                                    </div>
                                    {st.items.length>0?(
                                        <div className="flex flex-wrap gap-1">{st.items.map((item,i)=>(
                                            <span key={i} className="text-[9px] font-bold text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded-md">{item}</span>
                                        ))}</div>
                                    ):<span className="text-[9px] text-slate-300 font-bold">—</span>}
                                </div>
                            ))}
                        </div>

                        {/* ICDAS + C — compact side by side inline */}
                        <div className="c-fade c-d2 bg-white rounded-2xl border-2 border-slate-200 overflow-hidden">
                            <div className="bg-slate-900 text-white px-4 py-2 flex items-center justify-between">
                                <span className="text-[10px] font-black uppercase tracking-widest">ICDAS & {isRtl?'پروگزیمال':'Proximal'}</span>
                            </div>
                            <div className="grid grid-cols-2 divide-x divide-slate-100">
                                <div className="px-3 py-2">
                                    <div className="flex flex-wrap gap-1.5">
                                        {[['0',isRtl?'سالم':'Sound'],['1',isRtl?'مینا اولیه':'Early enamel'],['2',isRtl?'مینا واضح':'Distinct enamel'],['3',isRtl?'میکروکویتی':'Microcavity'],['4',isRtl?'سایه عاج':'Shadow'],['5',isRtl?'حفره':'Cavity'],['6',isRtl?'وسیع':'Extensive']].map(([c,d])=>(
                                            <div key={c} className="flex items-center gap-1.5 bg-slate-50 rounded-lg px-2 py-1">
                                                <span className="w-5 h-5 rounded-md bg-slate-900 text-white flex items-center justify-center font-black text-[9px]">{toFa(c,lang)}</span>
                                                <span className="text-[9px] font-bold text-slate-600">{d}</span>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                                <div className="px-3 py-2">
                                    <div className="flex flex-wrap gap-1.5">
                                        {[['C1',isRtl?'مینا خارجی':'Outer enamel'],['C2',isRtl?'مینا داخلی':'Inner enamel'],['C3',isRtl?'عاج خارجی':'Outer dentin'],['C4',isRtl?'عاج داخلی':'Inner dentin']].map(([c,d])=>(
                                            <div key={c} className="flex items-center gap-1.5 bg-slate-50 rounded-lg px-2 py-1">
                                                <span className="w-6 h-5 rounded-md bg-indigo-600 text-white flex items-center justify-center font-black text-[9px]">{c}</span>
                                                <span className="text-[9px] font-bold text-slate-600">{d}</span>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </div>

                        {/* Overrides */}
                        {(results.dOverride||results.eOverride)&&(
                            <div className="flex flex-wrap gap-3">
                                {results.dOverride&&<div className="bg-red-50 border-l-4 border-red-500 p-3 rounded-r-xl flex-1 min-w-[200px]"><span className="text-red-600 font-black text-[10px] uppercase flex items-center gap-1"><ArrowUpRight className="w-3 h-3"/>{t.diseaseOverride}</span></div>}
                                {results.eOverride&&<div className="bg-slate-900 text-white p-3 rounded-xl flex-1 min-w-[200px]"><span className="text-emerald-400 font-black text-[10px] uppercase flex items-center gap-1"><Zap className="w-3 h-3"/>{t.extremeOverride}</span></div>}
                            </div>
                        )}

                        {/* Action Plan */}
                        <div className="c-fade c-d3 space-y-3">
                            <div className="flex items-center gap-2 px-1"><ClipboardCheck className="w-4 h-4 text-indigo-600"/><h3 className="font-black text-slate-900 uppercase tracking-widest text-xs">{isRtl?'برنامه درمانی':'ACTION PLAN'}</h3><div className="flex-1 h-px bg-slate-200"/></div>
                            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div className="bg-white rounded-2xl border-2 border-slate-200 overflow-hidden hover:shadow-md transition-all">
                                    <div className="bg-slate-50 border-b border-slate-200 p-3 flex items-center gap-2"><Calendar className="w-3.5 h-3.5 text-slate-400"/><span className="font-black text-[10px] text-slate-500 uppercase tracking-wider">{t.recDiagnostics}</span></div>
                                    <div className="p-4"><div dangerouslySetInnerHTML={{__html:t[RecMap[results.finalCat].d]}} className="text-sm text-slate-700 leading-relaxed space-y-2"/></div>
                                </div>
                                <div className="bg-white rounded-2xl border-2 border-slate-900 overflow-hidden hover:shadow-md transition-all">
                                    <div className="bg-slate-900 p-3 flex items-center justify-between"><span className="font-black text-[10px] text-indigo-300 uppercase tracking-wider flex items-center gap-2"><Zap className="w-3.5 h-3.5"/>{t.recInterventions}</span><div className="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"/></div>
                                    <div className="p-4"><div dangerouslySetInnerHTML={{__html:t[RecMap[results.finalCat].i]}} className="text-sm text-slate-700 leading-relaxed space-y-2"/></div>
                                </div>
                            </div>
                        </div>

                        {/* Action Buttons */}
                        <div className="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
                            <button onClick={()=>setShowPdf(true)} className="group relative cursor-pointer active:scale-95 transition-transform w-full sm:w-auto">
                                <div className="absolute inset-0 bg-slate-700 rounded-xl translate-y-1"/>
                                <div className="relative bg-slate-800 text-white px-6 py-3 rounded-xl font-black text-sm flex items-center justify-center gap-2 group-hover:translate-y-0.5 transition-transform"><Download className="w-4 h-4"/>{isRtl?'ذخیره PDF':'Save PDF'}</div>
                            </button>
                            <button onClick={submit} disabled={isSubmitting} className="group relative cursor-pointer active:scale-95 transition-transform disabled:opacity-50 w-full sm:w-auto">
                                <div className="absolute inset-0 bg-indigo-800 rounded-xl translate-y-1"/>
                                <div className="relative bg-gradient-to-r from-indigo-600 to-purple-600 text-white px-6 py-3 rounded-xl font-black text-sm flex items-center justify-center gap-2 group-hover:translate-y-0.5 transition-transform shadow-lg shadow-indigo-300/20">
                                    {isSubmitting?<Activity className="animate-spin w-4 h-4"/>:<ClipboardCheck className="w-4 h-4"/>}
                                    {isSubmitting?(isRtl?'ثبت...':'SAVING...'):(isRtl?'ثبت و خروج':'FINISH & LOG')}
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </main>

            {/* NAV */}
            {!isW&&<nav className="fixed bottom-2 left-1/2 -translate-x-1/2 w-[calc(100%-1rem)] max-w-lg z-40 pointer-events-none">
                <div className="bg-white/90 backdrop-blur-xl border-2 border-slate-900 rounded-xl px-1.5 py-0.5 flex items-center justify-between gap-1 pointer-events-auto shadow-[3px_3px_0px_#0f172a]">
                    <button disabled={tabOrder.indexOf(activeTab)<=1} onClick={()=>setActiveTab(tabOrder[tabOrder.indexOf(activeTab)-1])}
                        className={`flex-shrink-0 w-7 h-7 rounded-lg bg-slate-100 flex items-center justify-center disabled:opacity-20 cursor-pointer active:scale-90 transition-all ${tabOrder.indexOf(activeTab)<=1?'invisible':''}`}>
                        <ChevronLeft className={`w-3.5 h-3.5 text-slate-800 ${isRtl?'scale-x-[-1]':''}`} strokeWidth={3}/>
                    </button>
                    <div className="flex flex-1 justify-center gap-1">
                        {tabOrder.filter(x=>x!=='welcome').map((tab,idx)=>{const ci=tabOrder.indexOf(activeTab)-1;return(
                            <div key={tab} className={`transition-all duration-400 ease-[cubic-bezier(.22,1,.36,1)] rounded-full border border-slate-900 ${idx===ci?'w-4 h-1.5 bg-indigo-500':idx<ci?'w-1.5 h-1.5 bg-slate-900':'w-1.5 h-1.5 bg-slate-300'}`}/>
                        )})}
                    </div>
                    <button disabled={tabOrder.indexOf(activeTab)===tabOrder.length-1||!isValid(activeTab)} onClick={()=>setActiveTab(tabOrder[tabOrder.indexOf(activeTab)+1])}
                        className={`flex-shrink-0 w-7 h-7 rounded-lg bg-slate-100 flex items-center justify-center disabled:opacity-20 cursor-pointer active:scale-90 transition-all ${tabOrder.indexOf(activeTab)===tabOrder.length-1?'invisible':''}`}>
                        <ChevronRight className={`w-3.5 h-3.5 text-slate-800 ${isRtl?'scale-x-[-1]':''}`} strokeWidth={3}/>
                    </button>
                </div>
            </nav>}

            <PdfModal open={showPdf} onClose={()=>setShowPdf(false)} lang={lang} patient={patient} results={results} config={config} diseaseInd={diseaseInd} riskFact={riskFact} protFact={protFact}/>

            {appAlert.show&&createPortal(
                <div className="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm">
                    <div className="c-scale bg-white border-4 border-slate-900 shadow-[8px_8px_0_rgba(0,0,0,1)] w-full max-w-sm p-6 text-center rounded-3xl">
                        <div className="mb-4">
                            {appAlert.type==='success'?<div className="w-14 h-14 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto border-4 border-emerald-500"><Check className="w-7 h-7" strokeWidth={4}/></div>
                            :<div className="w-14 h-14 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto border-4 border-red-500"><AlertCircle className="w-7 h-7" strokeWidth={4}/></div>}
                        </div>
                        <h3 className="text-lg font-black uppercase tracking-widest mb-3">{appAlert.type==='success'?(isRtl?'موفقیت':'SUCCESS'):(isRtl?'خطا':'ERROR')}</h3>
                        <p className="text-slate-600 font-bold mb-5">{appAlert.message}</p>
                        <button onClick={()=>{if(appAlert.onClose)appAlert.onClose();setAppAlert(a=>({...a,show:false,onClose:null}))}}
                            className="w-full py-3 bg-slate-900 text-white font-black uppercase tracking-widest rounded-xl hover:bg-slate-700 cursor-pointer active:scale-95 transition-all">
                            {isRtl?'باشه':'OK'}
                        </button>
                    </div>
                </div>,document.body
            )}
        </div>
    );
}
